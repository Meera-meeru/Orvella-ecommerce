<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Orvella | Wallet</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="store-page customer-page">
  <%- include('partials/store-header') %>
  <main class="page-shell customer-shell">
    <p class="page-kicker"><a href="/profile">← Back to your account</a></p>
    <header class="customer-page-heading"><div><p class="customer-eyebrow">YOUR ORVELLA WALLET</p><h1>Wallet &amp; rewards</h1><p>Refunds and referral rewards are ready for your next order.</p></div><span class="customer-count-pill">₹<%= balance.toFixed(2) %></span></header>
    <% if(referralCode){ %><section class="panel wallet-referral"><h2>Invite a friend</h2><p>Share your referral code. You and your friend each receive ₹100 after their first successful paid order.</p><strong><%= referralCode %></strong></section><% } %>
    <section class="panel wallet-ledger"><h2>Wallet activity</h2>
      <% if(transactions.length){ %><div class="admin-table-wrap"><table><thead><tr><th>Date</th><th>Description</th><th>Type</th><th>Amount</th></tr></thead><tbody><% transactions.forEach((transaction) => { %><tr><td><%= new Date(transaction.createdAt).toLocaleDateString('en-IN') %></td><td><%= transaction.description %></td><td><%= transaction.type %></td><td><%= transaction.type==='Credit' ? '+' : '−' %>₹<%= transaction.amount.toFixed(2) %></td></tr><% }) %></tbody></table></div><% } else { %><p>Your wallet activity will appear here.</p><% } %>
    </section>
  </main>
</body>
</html>
