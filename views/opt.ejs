<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Verify email | Orvella</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="auth-page">
  <main class="auth-card">
    <p><a class="auth-back" href="/">← Orvella home</a></p>
    <h1>Verify your email</h1>
    <p>Enter the 6-digit code sent to <strong><%= email %></strong>. Your account will be saved after the code is verified.</p>
    <% if(error){ %><p class="auth-error" role="alert"><%= error %></p><% } %>
    <% if(message){ %><p class="auth-success" role="status"><%= message %></p><% } %>
    <form action="/verify-otp" method="post">
      <input type="hidden" name="email" value="<%= email %>">
      <label for="otp">Email verification code</label>
      <input id="otp" name="otp" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="000000" required autofocus>
      <button type="submit">Verify OTP &amp; create account</button>
    </form>
    <div class="auth-timers">
      <span>Code expires in<strong id="otpTimer">05:00</strong></span>
      <span>Resend in<strong id="resendTimer">00:30</strong></span>
    </div>
    <form action="/resend-otp" method="post">
      <input type="hidden" name="email" value="<%= email %>">
      <button id="resendButton" type="submit" disabled>Resend OTP</button>
    </form>
    <p>If the code expires, return to signup and start again.</p>
  </main>
  <script>
    (() => {
      const expiresAt = Number(<%- JSON.stringify(expiresAt || Date.now()) %>);
      let resendAt = Number(<%- JSON.stringify(resendAvailableAt || Date.now()) %>);
      const otpTimer = document.getElementById('otpTimer');
      const resendTimer = document.getElementById('resendTimer');
      const resendButton = document.getElementById('resendButton');
      const format = (ms) => {
        const sec = Math.max(0, Math.ceil(ms / 1000));
        return String(Math.floor(sec / 60)).padStart(2, '0') + ':' + String(sec % 60).padStart(2, '0');
      };
      function tick() {
        const now = Date.now();
        otpTimer.textContent = format(expiresAt - now);
        resendTimer.textContent = format(resendAt - now);
        resendButton.disabled = now < resendAt || now >= expiresAt;
        if (now >= expiresAt) otpTimer.textContent = 'Expired';
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>
</body>
</html>
