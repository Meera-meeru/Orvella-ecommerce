<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify your Orvella email</title></head>
<body style="margin:0;background:#f4f6f8;font-family:Arial,sans-serif;color:#20252b;padding:24px">
  <table role="presentation" style="max-width:560px;width:100%;margin:20px auto;background:#fff;border-radius:14px;padding:32px;border:1px solid #e5e7eb">
    <tr><td>
      <h1 style="margin-top:0;color:#2563eb">Orvella</h1>
      <h2>Verify your email address</h2>
      <p>Hello <%= name %>,</p><p>Use this one-time password to finish creating your Orvella account.</p>
      <p style="font-size:32px;letter-spacing:8px;font-weight:bold;text-align:center;background:#eff6ff;padding:18px;border-radius:8px"><%= otp %></p>
      <p>This code expires in <strong><%= expiryMinutes %> minutes</strong>. Do not share it with anyone.</p>
      <p style="color:#667085;font-size:12px">If you did not request this code, you can ignore this email.</p>
    </td></tr>
  </table>
</body></html>
