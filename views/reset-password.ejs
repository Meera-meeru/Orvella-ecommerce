<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Choose a new password | Orvella</title><link rel="stylesheet" href="/styles.css"></head>
<body class="auth-page"><main class="auth-card"><p><a class="auth-back" href="/login">← Back to login</a></p><h1>Choose a new password</h1>
<% if(error){ %><p role="alert"><%= error %></p><% } %>
<% if(token){ %><form action="/reset-password" method="post"><input type="hidden" name="token" value="<%= token %>"><label for="password">New password</label><input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required><label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required><button type="submit">Update password</button></form><% } %></main></body></html>
