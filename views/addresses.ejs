<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Orvella | Addresses</title><link rel="stylesheet" href="/styles.css"></head>
<body class="store-page customer-page customer-addresses-page"><%- include('partials/store-header') %>
<main class="page-shell"><p><a href="/profile">Back to profile</a></p><h1>Saved addresses</h1><% if(error){ %><p role="alert"><%= error %></p><% } %>
<section class="cards"><% addresses.forEach(saved => { %><article class="panel"><h2><%= saved.label %> <%= saved.isDefault ? '(Default)' : '' %></h2><p><%= saved.name %> · <%= saved.phone %><br><%= saved.addressLine1 %><%= saved.addressLine2 ? ', ' + saved.addressLine2 : '' %><br><%= saved.city %>, <%= saved.state %> <%= saved.postalCode %>, <%= saved.country %></p><a href="/profile/addresses/<%= saved._id %>/edit">Edit</a><% if(!saved.isDefault){ %><form method="post" action="/profile/addresses/<%= saved._id %>/default"><button>Make default</button></form><% } %><form method="post" action="/profile/addresses/<%= saved._id %>/delete" onsubmit="return confirm('Delete this saved address?')"><button type="submit">Delete</button></form></article><% }) %></section>
<section class="panel"><h2><%= address ? 'Edit address' : 'Add an address' %></h2><form class="address-form" method="post" action="<%= address && address._id ? '/profile/addresses/' + address._id + '/edit' : '/profile/addresses' %>">
<div class="form-grid"><div><label for="addressLabel">Address label</label><input id="addressLabel" name="label" value="<%= address ? address.label || 'Home' : 'Home' %>" maxlength="40"></div>
<div><label for="recipientName">Recipient name</label><input id="recipientName" name="name" value="<%= address ? address.name || '' : '' %>" required maxlength="100"></div>
<div><label for="addressPhone">Phone</label><input id="addressPhone" name="phone" type="tel" value="<%= address ? address.phone || '' : '' %>" required pattern="[+0-9() -]{7,20}" maxlength="20"></div>
<div><label for="addressCountry">Country</label><input id="addressCountry" name="country" value="<%= address ? address.country || 'India' : 'India' %>" required maxlength="80"></div></div>
<label for="addressLine1">Address line 1</label><input id="addressLine1" name="addressLine1" autocomplete="address-line1" value="<%= address ? address.addressLine1 || '' : '' %>" required maxlength="160">
<label for="addressLine2">Address line 2 (optional)</label><input id="addressLine2" name="addressLine2" autocomplete="address-line2" value="<%= address ? address.addressLine2 || '' : '' %>" maxlength="160">
<div class="form-grid"><div><label for="addressCity">City</label><input id="addressCity" name="city" autocomplete="address-level2" value="<%= address ? address.city || '' : '' %>" required maxlength="80"></div>
<div><label for="addressState">State</label><input id="addressState" name="state" autocomplete="address-level1" value="<%= address ? address.state || '' : '' %>" required maxlength="80"></div>
<div><label for="addressPostalCode">Postal code</label><input id="addressPostalCode" name="postalCode" autocomplete="postal-code" value="<%= address ? address.postalCode || '' : '' %>" required maxlength="20"></div></div>
<label><input type="checkbox" name="isDefault" <%= address && address.isDefault ? 'checked' : '' %>> Set as default address</label><button type="submit">Save address</button></form></section></main></body></html>
