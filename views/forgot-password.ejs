<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reset password | Orvella</title><link rel="stylesheet" href="/styles.css"></head>
<body class="auth-page"><main class="auth-card"><p><a class="auth-back" href="/login">← Back to login</a></p><h1>Reset your password</h1>
<% if(error){ %><p role="alert"><%= error %></p><% } %>
<% if(message){ %><p role="status"><%= message %></p><% } else { %><p>Enter your email and we will send reset instructions if the account exists.</p><form action="/forgot-password" method="post"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required><button type="submit">Send reset link</button></form><% } %></main></body></html>
