<% const settings = { storeName: 'Orvella', supportEmail: 'support@orvella.example', currency: 'USD', lowStockAlert: true, orderNotifications: true }; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Orvella Admin | Settings</title>  <link rel="stylesheet" href="/styles.css">
</head><body class="admin-page"><main class="panel"><p><a href="/admin">Admin dashboard</a></p><h1>Store settings</h1><form action="/admin/settings" method="post"><label for="storeName">Store name</label><input id="storeName" name="storeName" type="text" value="<%= settings.storeName %>" required><label for="supportEmail">Support email</label><input id="supportEmail" name="supportEmail" type="email" value="<%= settings.supportEmail %>" required><label for="currency">Currency</label><select id="currency" name="currency"><option selected><%= settings.currency %></option><option>EUR</option><option>GBP</option></select><label class="check"><input name="lowStockAlert" type="checkbox" <%= settings.lowStockAlert ? 'checked' : '' %>> Send low-stock alerts</label><label class="check"><input name="orderNotifications" type="checkbox" <%= settings.orderNotifications ? 'checked' : '' %>> Send new-order notifications</label><button type="submit">Save settings</button></form></main></body></html>
