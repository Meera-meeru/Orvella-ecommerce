<% const products = [{ id: 1, name: 'Minimal Leather Backpack', category: 'Bags', price: 79.99, stock: 14, status: 'Active' }, { id: 2, name: 'Wireless Headphones', category: 'Audio', price: 129.00, stock: 32, status: 'Active' }, { id: 3, name: 'Everyday Sneakers', category: 'Footwear', price: 64.50, stock: 0, status: 'Draft' }]; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Orvella Admin | Products</title>  <link rel="stylesheet" href="/styles.css">
</head><body class="admin-page"><main class="main"><p><a href="/admin">Admin dashboard</a></p><div class="top"><h1>Products</h1><a class="button" href="/admin/products/new">Add product</a></div><section class="panel"><table class="table"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody><% products.forEach(product => { %><tr><td><%= product.name %></td><td><%= product.category %></td><td>$<%= product.price.toFixed(2) %></td><td><%= product.stock %></td><td><%= product.status %></td><td><a class="link" href="/admin/products/<%= product.id %>/edit">Edit</a><a class="link" href="/admin/products/<%= product.id %>/delete">Delete</a></td></tr><% }); %></tbody></table></section></main></body></html>
