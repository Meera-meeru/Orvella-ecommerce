<% const metrics = [{ label: 'Revenue', value: '$24,680', change: '+12.4%' }, { label: 'Orders', value: '348', change: '+8.2%' }, { label: 'Customers', value: '1,204', change: '+5.7%' }, { label: 'Products', value: '86', change: '+3 new' }]; const recentOrders = [{ id: 'SHP-1048', customer: 'Alex Antony', total: '$208.99', status: 'Delivered' }, { id: 'SHP-1047', customer: 'Jamie Rivera', total: '$129.00', status: 'Processing' }, { id: 'SHP-1046', customer: 'Morgan Taylor', total: '$64.50', status: 'Shipped' }]; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Orvella Admin | Dashboard</title>  <link rel="stylesheet" href="/styles.css">
</head><body class="admin-page"><div class="layout"><aside class="sidebar"><div class="brand">Orvella Admin</div><a href="/admin">Dashboard</a><a href="/admin/products">Products</a><a href="/admin/orders">Orders</a><a href="/admin/users">Users</a><a href="/admin/settings">Settings</a><a href="/">View store</a></aside><main class="main"><h1>Dashboard</h1><section class="metrics"><% metrics.forEach(metric => { %><article class="metric"><span><%= metric.label %></span><strong><%= metric.value %></strong><span class="change"><%= metric.change %></span></article><% }); %></section><section class="panel"><h2>Recent orders</h2><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead><tbody><% recentOrders.forEach(order => { %><tr><td><%= order.id %></td><td><%= order.customer %></td><td><%= order.total %></td><td><%= order.status %></td></tr><% }); %></tbody></table></section></main></div></body></html>
