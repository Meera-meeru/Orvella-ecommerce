<% const users = [{ id: 1, name: 'Alex Antony', email: 'alex@example.com', orders: 12, joined: 'Jan 2025', status: 'Active' }, { id: 2, name: 'Jamie Rivera', email: 'jamie@example.com', orders: 8, joined: 'Mar 2025', status: 'Active' }, { id: 3, name: 'Morgan Taylor', email: 'morgan@example.com', orders: 3, joined: 'Jun 2026', status: 'Suspended' }]; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Orvella Admin | Users</title>  <link rel="stylesheet" href="/styles.css">
</head><body class="admin-page"><main class="main"><p><a href="/admin">Admin dashboard</a></p><h1>Users</h1><section class="panel"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Orders</th><th>Joined</th><th>Status</th><th></th></tr></thead><tbody><% users.forEach(user => { %><tr><td><%= user.name %></td><td><%= user.email %></td><td><%= user.orders %></td><td><%= user.joined %></td><td><%= user.status %></td><td><a class="link" href="/admin/users/<%= user.id %>">View</a></td></tr><% }); %></tbody></table></section></main></body></html>
