<% const product = { name: '', category: '', price: '', stock: '', description: '' }; const isEdit = false; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Orvella Admin | <%= isEdit ? 'Edit' : 'Add' %> product</title>  <link rel="stylesheet" href="/styles.css">
</head><body class="admin-page"><main class="panel"><p><a href="/admin/products">Back to products</a></p><h1><%= isEdit ? 'Edit' : 'Add' %> product</h1><form action="/admin/products" method="post"><label for="name">Product name</label><input id="name" name="name" type="text" value="<%= product.name %>" required><div class="row"><div><label for="category">Category</label><select id="category" name="category"><option>Bags</option><option>Audio</option><option>Clothing</option><option>Footwear</option><option>Home</option></select></div><div><label for="price">Price</label><input id="price" name="price" type="number" step="0.01" value="<%= product.price %>" required></div></div><label for="stock">Stock quantity</label><input id="stock" name="stock" type="number" min="0" value="<%= product.stock %>" required><label for="description">Description</label><textarea id="description" name="description"><%= product.description %></textarea><button type="submit">Save product</button></form></main></body></html>
