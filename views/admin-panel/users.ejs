<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>User Management | Orvella</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="admin-page">
  <div class="admin-layout">
    <%- include('sidebar', { active: 'users' }) %>
    <main class="admin-content">
    <header class="admin-page-header"><div><p class="admin-eyebrow">CUSTOMER DIRECTORY</p><h1>User management</h1></div></header>
    <section class="admin-table-wrap">
      <table>
        <thead><tr><th>Name</th><th>Email</th><th>Joined</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
          <% users.forEach(user => { const isBlocked=blocked.has(String(user._id)); %>
            <tr>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : '-' %></td>
              <td><%= isBlocked ? 'Blocked' : 'Active' %></td>
              <td><form method="post" action="/admin/users/<%= user._id %>/<%= isBlocked ? 'unblock' : 'block' %>"><button type="submit"><%= isBlocked ? 'Unblock' : 'Block' %></button></form></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if(!users.length){ %><p>No users found.</p><% } %>
    </section>
    </main>
  </div>
</body>
</html>
